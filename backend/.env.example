# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/ai_voice_to_text
# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_voice_to_text?retryWrites=true&w=majority

# Session Secret (Use a strong random string)
SESSION_SECRET=super_secret_voice_to_text_session_key_2026_xyz

# Frontend URL (For CORS if frontend is served from a different port, e.g. Live Server)
CLIENT_URL=http://localhost:5000

